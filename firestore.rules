rules_version = '2';

// Open read/write for early development (cloud). Replace with auth-scoped rules before production.
service cloud.firestore {
  match /databases/{database}/documents {
    // Users CRUD goes through Next.js API routes (Admin SDK only).
    match /users/{userId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
